{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "inab",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"logs": {
			"enabled": true
		}
	},
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	"services": [
		{
			"binding": "GLOBAL_OUTBOUND",
			"service": "inab",
			"entrypoint": "GlobalOutbound"
		},
		{
			"binding": "R2_PROXY",
			"service": "inab",
			"entrypoint": "R2Proxy"
		}
	],
	"r2_buckets": [
		{
			"binding": "STAGING_R2",
			"bucket_name": "inab-staging"
		}
	],
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "24ddf42327f84297a364946e1e85d8f5"
		}
	],
	"vars": {
		"YNAB_API_BASE": "https://api.ynab.com/v1",
		"YNAB_OAUTH_BASE": "https://app.ynab.com/oauth"
	},
	"dev": {
		"port": 2529
	}
}
