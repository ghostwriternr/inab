{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ynab-mcp-dev",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "logs": { "enabled": true } },
  "worker_loaders": [{ "binding": "LOADER" }],
  "services": [
    {
      "binding": "GLOBAL_OUTBOUND",
      "service": "ynab-mcp-dev",
      "entrypoint": "GlobalOutbound"
    }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "vars": {
    "YNAB_API_BASE": "https://api.ynab.com/v1",
    "YNAB_OAUTH_BASE": "https://app.ynab.com/oauth",
    "ALLOWED_ORIGINS": ""
  },
  "dev": { "port": 2529 },
  "env": {
    "staging": {
      "name": "ynab-mcp-staging",
      "worker_loaders": [{ "binding": "LOADER" }],
      "services": [
        {
          "binding": "GLOBAL_OUTBOUND",
          "service": "ynab-mcp-staging",
          "entrypoint": "GlobalOutbound"
        }
      ],
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "placeholder-staging" }
      ],
      "vars": {
        "YNAB_API_BASE": "https://api.ynab.com/v1",
        "YNAB_OAUTH_BASE": "https://app.ynab.com/oauth",
        "ALLOWED_ORIGINS": ""
      }
    },
    "production": {
      "name": "ynab-mcp",
      "worker_loaders": [{ "binding": "LOADER" }],
      "services": [
        {
          "binding": "GLOBAL_OUTBOUND",
          "service": "ynab-mcp",
          "entrypoint": "GlobalOutbound"
        }
      ],
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "placeholder-production" }
      ],
      "vars": {
        "YNAB_API_BASE": "https://api.ynab.com/v1",
        "YNAB_OAUTH_BASE": "https://app.ynab.com/oauth",
        "ALLOWED_ORIGINS": ""
      }
    }
  }
}
